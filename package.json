{
	"name": "tracking-handler",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "node scripts/build.mjs",
		"check": "npm run format:check && npm run lint && npm test",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit",
		"test": "npm run typecheck && npm run build && node --test test/*.test.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "latest",
		"esbuild": "latest",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.12.0",
		"linkedom": "^0.18.13",
		"prettier": "^3.9.6",
		"typescript": "latest",
		"typescript-eslint": "^8.69.0"
	}
}
